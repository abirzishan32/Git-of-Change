# Copy this file to `.env` and fill in the values. Never commit `.env`.

PORT=5000
NODE_ENV=development

# Local MongoDB, or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/gift-of-change

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Origin(s) allowed by CORS, comma-separated
CLIENT_URL=http://localhost:5173

# Set to true when running behind a reverse proxy (Render, Railway, Nginx, ...)
TRUST_PROXY=false

# Stripe test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Printed by `stripe listen --forward-to localhost:5000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_...
