# Copy this file to `.env`.

# Base URL of the API. Leave empty in development: Vite proxies /api to
# http://localhost:5000 (override with API_PROXY_TARGET). Set it when the API
# is deployed on a different domain, e.g. https://gift-of-change-api.onrender.com
VITE_API_URL=

# Stripe publishable test key: https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
