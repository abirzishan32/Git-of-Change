{
  "name": "gift-of-change",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack donation platform built with React, Express, MongoDB and Stripe",
  "license": "MIT",
  "author": "Abir Rahman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abirzishan32/donation-website.git"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": "^22.22.0 || >=24"
  },
  "scripts": {
    "dev": "concurrently --names server,client --prefix-colors blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "npm run seed -w server",
    "create-admin": "npm run create-admin -w server --"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.9.6"
  }
}
